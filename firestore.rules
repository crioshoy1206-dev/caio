rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // 내 일정, 할 일, 시간표, 설정: 본인만
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
    }

    // 공개 프로필: 친구 코드로 찾을 수 있게 로그인한 사람은 읽기 가능, 쓰기는 본인만
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }

    // 친구 관계: 두 사람만 읽고, 요청한 사람이 만들고, 받은 사람만 수락, 둘 다 삭제 가능
    match /friendships/{id} {
      // 아직 없는 문서는 내 uid가 들어간 id일 때만 조회 가능 (이미 요청했는지 확인용)
      allow read: if signedIn() && (
        resource == null ? id.split('_').hasAny([me()]) : me() in resource.data.memberIds
      );
      allow delete: if signedIn() && me() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.requestedBy == me()
        && me() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && me() in resource.data.memberIds
        && resource.data.requestedBy != me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
    }

    // 함께하는 일정: 참여자만 읽기/수정, 만든 사람만 참여자 목록 변경과 삭제
    match /sharedEvents/{id} {
      allow read: if signedIn() && me() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && me() in request.resource.data.memberIds;
      allow update: if signedIn() && me() in resource.data.memberIds && (
        resource.data.ownerId == me()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'memberIds'])
      );
      allow delete: if signedIn() && resource.data.ownerId == me();

      match /messages/{msgId} {
        allow read: if signedIn() && me() in get(/databases/$(database)/documents/sharedEvents/$(id)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.uid == me()
          && me() in get(/databases/$(database)/documents/sharedEvents/$(id)).data.memberIds;
        // 계정 삭제용: 보낸 사람은 자기 메시지를, 일정을 만든 사람은 모든 메시지를 지울 수 있음
        allow delete: if signedIn() && (
          resource.data.uid == me()
          || get(/databases/$(database)/documents/sharedEvents/$(id)).data.ownerId == me()
        );
      }
    }
  }
}
